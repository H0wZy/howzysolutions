{
  "name": "howzysolutions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vite dev --port 3001",
    "data": "node scripts/stamp-build.mjs && node scripts/fetch-wakatime.mjs && node scripts/fetch-github.mjs && node scripts/fetch-mcp.mjs && node scripts/generate-mcp-markdown.mjs && node scripts/extract-cv.mjs && node scripts/generate-cv-markdown.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "build:next": "next build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "parity": "node scripts/parity-diff.mjs",
    "lint": "eslint .",
    "cv:extract": "node scripts/extract-cv.mjs",
    "cv:markdown": "node scripts/generate-cv-markdown.mjs",
    "test": "vitest run && node scripts/check-contrast.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@vinext/cloudflare": "1.4.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "3.2.7",
    "wrangler": "4.164.0"
  }
}
