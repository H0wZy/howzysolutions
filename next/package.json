{
  "name": "howzysolutions-next",
  "version": "0.0.0",
  "description": "howzysolutions on Next.js (vinext) for Cloudflare Workers, spec 006",
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "prebuild": "node scripts/sync-public.mjs",
    "predev:vinext": "node scripts/sync-public.mjs",
    "prebuild:vinext": "node scripts/sync-public.mjs",
    "build": "vite build",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@vinext/cloudflare": "1.2.1",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
