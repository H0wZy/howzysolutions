// A Worker with static assets: dist/ is served as-is, and the one script,
// worker/index.ts, answers POST /api/contact (the contact form) and nothing else.
// Docs: developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "howzysolutions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    // /cv -> 307 -> /cv/, which serves dist/cv/index.html. Every internal link
    // already ends in a slash, so a visitor never takes the extra hop.
    "html_handling": "auto-trailing-slash",
    // No 404.html is emitted yet, so an unknown path is a plain 404. Never
    // "single-page-application": that answers every unknown path with the
    // home page and a 200.
    "not_found_handling": "none",
    // Only /api/* reaches the script. Everything else is answered by the assets
    // layer alone, so public/_redirects and public/_headers keep working and the
    // site costs no Worker invocation to read.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Not a secret. The sender shown on the mail; the domain must be verified in
    // Resend. The three secrets are set with `wrangler secret put`, never here:
    // RESEND_API_KEY, TURNSTILE_SECRET, CONTACT_TO.
    "CONTACT_FROM": "howzysolutions <contact@howzysolutions.com>"
  },
  "routes": [{ "pattern": "howzysolutions.com", "custom_domain": true }],
  // One public origin. www is a redirect rule on the zone, not a second copy.
  "workers_dev": false,
  "preview_urls": false
}
